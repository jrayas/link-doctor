{
	"name": "link-doctor",
	"version": "0.1.0",
	"description": "Obsidian plugin that finds and reports broken links and empty notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:bundle": "node scripts/check-forbidden.mjs --bundle",
		"verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:bundle",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"install:test-vault": "npm run build && node scripts/install-to-test-vault.mjs",
		"bench": "node scripts/bench.mjs"
	},
	"keywords": [
		"obsidian",
		"links"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"jsdom": "^30.1.2",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.4"
	},
	"author": "Anthirayas"
}
